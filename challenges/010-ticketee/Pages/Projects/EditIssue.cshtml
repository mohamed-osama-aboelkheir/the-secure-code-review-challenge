@page "/projects/{key}/issues/{issueKey}/edit"
@model EditIssueModel
@{
    ViewData["Title"] = $"Edit {Model.IssueKey}";
    ViewData["Nav"] = "projects";
    ViewData["Tab"] = "issues";
}
<partial name="_ProjectHeader" model="Model" />
<div class="card form-card">
    <h2>Edit <span class="mono">@Model.IssueKey</span></h2>
    <partial name="_IssueForm" model="Model.Form()" />
</div>
